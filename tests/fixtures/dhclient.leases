lease {
  interface "eth0";
  fixed-address 192.168.1.50;
  option subnet-mask 255.255.255.0;
  option routers 192.168.1.1;
  option dhcp-server-identifier 192.168.1.1;
  renew 1 2026/09/14 10:00:00;
}
lease {
  interface "eth0";
  fixed-address 192.168.1.50;
  option subnet-mask 255.255.255.0;
  option routers 192.168.1.1;
  option dhcp-lease-time 60;
  option rfc3442-classless-static-routes 1,0,192,168,1,66,1,128,192,168,1,66;
  option dhcp-server-identifier 192.168.1.66;
  renew 1 2026/09/21 10:00:00;
}
